# Copy to .env and fill in values. Do not commit .env.

# Optional: Character thoughts → “AI: deep research & update sources” (OpenAI API)
# OPENAI_API_KEY=sk-...
# OPENAI_RESEARCH_MODEL=gpt-4o-mini
# MONOLOGUE_STREAM_MODEL=gpt-4o-mini   # endless thought-page lines (public /thoughts/…)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Production HTTPS/proxy settings. Leave these false locally.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# MySQL (defaults in settings.py are overridden by these)
DB_NAME=mydb
DB_USER=imguser
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional local fallback if MySQL is unavailable:
# DB_ENGINE=sqlite
# DB_SQLITE_PATH=/absolute/path/to/db.sqlite3

# Optional: AWS S3 for media (set USE_S3_STORAGE=True and configure bucket)
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Cloudflare R2 for production static/media storage.
USE_R2_STORAGE=False
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Optional: override on-disk audio library (default: <project>/composition_audio_sources/)
# COMPOSITION_AUDIO_SOURCES_ROOT=/absolute/path/to/composition_audio_sources

# Optional: Netscape cookies.txt after logging into Yandex in a browser (reduces CAPTCHA HTML on scrapes).
# Same idea as INSTAGRAM_COOKIES_FILE — export with e.g. "Get cookies.txt LOCALLY" extension.
# YANDEX_COOKIES_FILE=/absolute/path/to/yandex_cookies.txt

# Playwright video export (composition detail → Generate Video Now)
# PLAYWRIGHT_HEADLESS=true         # false = visible browser window (often fixes black video exports on macOS)
# PLAYWRIGHT_CHROME_CHANNEL=chrome # force Google Chrome (usually not needed; the app tries Chrome first)
# PLAYWRIGHT_RENDER_DEBUG=1        # save media/renders/debug_render_<id>.png before recording

# Optional: tune large uploads (defaults exist in settings.py)
# DATA_UPLOAD_MAX_NUMBER_FILES=5000
# DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
# FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
