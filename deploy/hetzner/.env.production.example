# Core Django
DEBUG=False
DJANGO_SECRET_KEY=replace-me
ALLOWED_HOSTS=edfornieles.com,www.edfornieles.com
CSRF_TRUSTED_ORIGINS=https://edfornieles.com,https://www.edfornieles.com
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Database
DB_ENGINE=mysql
DB_NAME=replace-me
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Cloudflare R2 (static/media + composition publish)
USE_R2_STORAGE=True
R2_ACCOUNT_ID=replace-me
R2_BUCKET_NAME=edfornieles-composition-prod
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Optional legacy AWS-style compatibility variables
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me

